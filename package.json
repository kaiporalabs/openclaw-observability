{
  "name": "@kaiporalabs/openclaw-observability",
  "version": "1.1.3",
  "description": "Vendor-agnostic OpenClaw observability plugin with configurable file (NDJSON) and webhook exporters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiporalabs/openclaw-observability.git"
  },
  "bugs": {
    "url": "https://github.com/kaiporalabs/openclaw-observability/issues"
  },
  "files": [
    "dist",
    "docs",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "observability",
    "metrics",
    "tracing",
    "webhook",
    "logging"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.0"
  },
  "devDependencies": {
    "openclaw": "2026.5.2",
    "typescript": "~5.9.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.2",
      "minGatewayVersion": "2026.5.2"
    },
    "build": {
      "openclawVersion": "2026.5.2",
      "pluginSdkVersion": "2026.5.2"
    },
    "install": {
      "npmSpec": "@kaiporalabs/openclaw-observability",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.0"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  }
}
